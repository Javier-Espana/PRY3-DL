# Documentos reales con datos personales: no se suben. Solo sintéticos (sint_*) o anonimizados.
data/docs/*
!data/docs/.gitkeep
!data/docs/README.md
!data/docs/sint_*

# Resultados de corridas locales (se regeneran con src/evaluate.py)
results/*.json
!results/.gitkeep
